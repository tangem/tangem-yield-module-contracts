{
  "name": "tangem-yield-module-contracts",
  "version": "0.0.1",
  "description": "EVM smart contracts for Tangem Yield Module",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "build:prod": "FOUNDRY_PROFILE=prod forge build --sizes",
    "clean": "hardhat clean && forge clean",
    "export:abi": "hardhat export-abi",
    "test": "npm run test:foundry && npm run test:hardhat",
    "test:foundry": "forge test",
    "test:foundry:prod": "FOUNDRY_PROFILE=prod forge test",
    "test:hardhat": "hardhat test",
    "coverage": "make coverage",
    "gas": "make gas_snapshot",
    "format:sol": "forge fmt",
    "lint": "npm run lint:sol",
    "lint:sol": "solhint --disc --noPoster 'contracts/**/*.sol' 'test/**/*.sol'",
    "lint:sol:fix": "solhint --disc --noPoster --fix --noPrompt 'contracts/**/*.sol' 'test/**/*.sol'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangem/tangem-yield-module-contracts.git"
  },
  "keywords": [
    "Tangem",
    "smart contracts",
    "yield",
    "DeFi",
    "lending",
    "cryptocurrency",
    "EVM",
    "solidity"
  ],
  "author": "Tangem",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/tangem/tangem-yield-module-contracts/issues"
  },
  "homepage": "https://github.com/tangem/tangem-yield-module-contracts#readme",
  "devDependencies": {
    "@aave/core-v3": "1.19.3",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@openzeppelin/contracts": "5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0",
    "@solidstate/hardhat-bytecode-exporter": "1.1.1",
    "@tenderly/hardhat-tenderly": "^2.6.0",
    "dotenv": "16.5.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "hardhat": "2.26.3",
    "hardhat-abi-exporter": "2.11.0",
    "solhint": "6.2.3"
  }
}
